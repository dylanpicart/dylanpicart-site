---
// projects/index.astro — browseable catalog, split into Professional and Research
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects'))
  .filter((p) => p.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const professional = all.filter((p) => p.data.section === 'professional');
const research     = all.filter((p) => p.data.section === 'research');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const allTags = [...new Set(all.flatMap((p) => p.data.tags))].sort();
---
<Base title="Projects — Dylan K. Picart">
  <section>
    <h1>Projects</h1>
    <p style="color: var(--ink-soft); max-width: 40rem;">
      Field notes from real pipelines and published research, along with the code that ran them.
    </p>

      <div class="tag-filter" id="tag-filter" aria-label="Filter by topic">
        <button class="tag-filter-btn active" data-tag="all">All</button>
        {allTags.map((tag) => (
          <button class="tag-filter-btn" data-tag={tag}>{tag}</button>
        ))}
      </div>

    <!-- ── Professional Work ────────────────────────────────── -->
    <h2 class="section-label" id="label-professional">Professional Work</h2>

    <div class="projects-grid" id="grid-professional" style="display: grid; gap: 1.4rem; margin-top: 1rem;">
      {professional.map((p) => (
        <a href={`/projects/${p.id}/`} class="card reveal project-card" data-tags={p.data.tags.join(',')} style="text-decoration: none; display: block;">
          <p class="meta" style="font-size: 0.8rem; font-weight: 700; color: var(--ink-soft); margin: 0 0 0.4rem; letter-spacing: 0.06em; text-transform: uppercase;">
            {fmt(p.data.date)}
          </p>
          <h2 style="margin: 0 0 0.5rem; font-size: 1.35rem;">{p.data.title}</h2>
          <p style="color: var(--ink-soft); margin: 0 0 0.8rem;">{p.data.description}</p>
          <p style="margin: 0 0 0.5rem;">
            {p.data.langs.map((lang) => (
              <span class={`chip ${lang.toLowerCase()}`}>{lang}</span>
            ))}
          </p>
          {p.data.tags.length > 0 && (
            <p style="margin: 0;">
              {p.data.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </p>
          )}
        </a>
      ))}
    </div>

    <!-- ── Research ─────────────────────────────────────────── -->
    <h2 class="section-label" id="label-research" style="margin-top: 4rem;">Research</h2>

    <div class="projects-grid" id="grid-research" style="display: grid; gap: 1.4rem; margin-top: 1rem;">
      {research.map((p) => (
        <a href={`/projects/${p.id}/`} class="card reveal project-card" data-tags={p.data.tags.join(',')} style="text-decoration: none; display: block;">
          <p class="meta" style="font-size: 0.8rem; font-weight: 700; color: var(--ink-soft); margin: 0 0 0.4rem; letter-spacing: 0.06em; text-transform: uppercase;">
            {fmt(p.data.date)}
          </p>
          <h2 style="margin: 0 0 0.5rem; font-size: 1.35rem;">{p.data.title}</h2>
          <p style="color: var(--ink-soft); margin: 0 0 0.8rem;">{p.data.description}</p>
          <p style="margin: 0 0 0.5rem;">
            {p.data.langs.map((lang) => (
              <span class={`chip ${lang.toLowerCase()}`}>{lang}</span>
            ))}
          </p>
          {p.data.tags.length > 0 && (
            <p style="margin: 0;">
              {p.data.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </p>
          )}
        </a>
      ))}
    </div>
    <p id="no-results" style="display: none; color: var(--ink-soft); margin-top: 2rem; font-weight: 600;">
      No projects match that tag.
    </p>
  </section>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons  = document.querySelectorAll('.tag-filter-btn');
      const cards    = document.querySelectorAll('.project-card');
      const labelPro = document.getElementById('label-professional');
      const labelRes = document.getElementById('label-research');
      const gridPro  = document.getElementById('grid-professional');
      const gridRes  = document.getElementById('grid-research');
      const noRes    = document.getElementById('no-results');

      function filter(tag) {
        let visiblePro = 0, visibleRes = 0;

        cards.forEach((card) => {
          const tags = (card.dataset.tags || '').split(',');
          const show = tag === 'all' || tags.includes(tag);
          card.style.display = show ? 'block' : 'none';
          if (show) {
            card.style.opacity = '1';
            card.style.transform = 'none';
          }

          if (show) {
            if (gridPro.contains(card)) visiblePro++;
            if (gridRes.contains(card)) visibleRes++;
          }
        });

        labelPro.style.display = visiblePro === 0 ? 'none' : '';
        gridPro.style.display  = visiblePro === 0 ? 'none' : 'grid';
        labelRes.style.display = visibleRes === 0 ? 'none' : '';
        gridRes.style.display  = visibleRes === 0 ? 'none' : 'grid';

        noRes.style.display = (visiblePro + visibleRes === 0) ? 'block' : 'none';
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          filter(btn.dataset.tag);
        });
      });
  });
  </script>
</Base>
