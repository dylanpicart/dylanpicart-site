---
// Base.astro — shared shell for every page.
// Nav, gradient background, pipeline spine, fonts, GSAP.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Show the pipeline spine (homepage only). */
  spine?: boolean;
}

const {
  title = 'Dylan K. Picart — Data Engineering · Data Science · Machine Learning',
  description = 'Data Engineer and Scientist building ethical, community-centered data systems for socioeconomic, educational, and environmental impact.',
  spine = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" type="image/png" />

  <!-- Inter — same font as the current site -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <!-- KaTeX — math rendering for blog posts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css" />
</head>
<body>

  <nav class="nav">
    <a class="brand" href="/">
      <img class="brand-logo" src="/images/site-logo.png" alt="" />
      DYLAN K. PICART
    </a>
    <ul>
      <li><a href="/about/">About</a></li>
      <li><a href="/projects/">Projects</a></li>
      <li><a href="/resume/">Resume</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
  </nav>

  {spine && (
    <aside class="spine" aria-hidden="true">
      <div class="track"></div>
      <div class="flow"></div>
      <!-- Nodes are positioned by JS to align with their sections.
           Labels tell the quiet pipeline joke: source → sink. -->
      <div class="node" data-section="hero"><span>source</span></div>
      <div class="node" data-section="about"><span>extract</span></div>
      <div class="node" data-section="projects"><span>transform</span></div>
      <div class="node" data-section="experience"><span>load</span></div>
      <div class="node" data-section="contact"><span>sink</span></div>
    </aside>
  )}

  <main>
    <slot />
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Dylan K. Picart</p>
  </footer>

  <!-- GSAP + ScrollTrigger from CDN (cached everywhere, ~60KB total) -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script is:inline src="/js/main.js"></script>
</body>
</html>
